---
// Import fonts
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/inter/700.css'
import '@fontsource/inter/900.css'
import '@fontsource-variable/raleway/wght.css'
---

<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Pool - Event Funding Simplified</title>
        <link rel='icon' type='image/x-icon' href='/favicon.ico' />

        <!-- Preconnect to Google Fonts -->
        <link rel='preconnect' href='https://fonts.googleapis.com' />
        <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
        <link
            href='https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap'
            rel='stylesheet'
        />

        <!-- Preload critical fonts -->
        <link rel='preload' href='/fonts/inter-latin-500-normal.woff2' as='font' type='font/woff2' crossorigin />
    </head>
    <body>
        <section class='sticky'>
            <div class='gallery-wrapper'>
                <div class='col side-1'>
                    <div class='img'><img src='/img1.png' alt='' /></div>
                    <div class='img'><img src='/img2.png' alt='' /></div>
                    <div class='img'><img src='/img3.png' alt='' /></div>
                </div>

                <div class='col side-2'>
                    <div class='img'><img src='/img4.png' alt='' /></div>
                    <div class='img'><img src='/img1.png' alt='' /></div>
                    <div class='img'><img src='/img6.png' alt='' /></div>
                </div>

                <div class='col main'>
                    <div class='img'><img src='/img7.png' alt='' /></div>
                    <div class='img main'><img src='/img8.png' alt='' /></div>
                    <div class='img'><img src='/img9.png' alt='' /></div>
                </div>

                <div class='col side-3'>
                    <div class='img'><img src='/img1.png' alt='' /></div>
                    <div class='img'><img src='/img2.png' alt='' /></div>
                    <div class='img'><img src='/img3.png' alt='' /></div>
                </div>

                <div class='col side-4'>
                    <div class='img'><img src='/img4.png' alt='' /></div>
                    <div class='img'><img src='/vid.png' alt='' /></div>
                    <div class='img'><img src='/img6.png' alt='' /></div>
                </div>
            </div>
        </section>

        <main class='main-content'>
            <div class='hero-wrapper'>
                <section class='hero' id='hero'>
                    <div class='hero-background'>
                        <img src='/blue-hero-background.png' alt='Blue gradient background' />
                    </div>

                    <div class='nav-container'>
                        <!-- Desktop Navigation -->
                        <nav class='desktop-navbar'>
                            <ul class='nav-links'>
                                <li><a href='#'>How it works</a></li>
                                <li><a href='https://app.poolparty.cc'>Join</a></li>
                                <li><a href='#'>Host</a></li>
                                <li><a href='https://t.me/poolpartycc'>Contact Us</a></li>
                            </ul>
                        </nav>

                        <!-- Mobile Hamburger Button -->
                        <button class='hamburger-menu' aria-label='Menu'>
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                    </div>

                    <!-- Mobile Navigation Menu -->
                    <div class='mobile-nav'>
                        <div class='mobile-nav-content'>
                            <button class='close-menu' aria-label='Close Menu'>
                                <svg
                                    width='24'
                                    height='24'
                                    viewBox='0 0 24 24'
                                    fill='none'
                                    xmlns='http://www.w3.org/2000/svg'>
                                    <path
                                        d='M18 6L6 18M6 6L18 18'
                                        stroke='currentColor'
                                        stroke-width='2'
                                        stroke-linecap='round'
                                        stroke-linejoin='round'></path>
                                </svg>
                            </button>
                            <ul>
                                <li><a href='#'>How it works</a></li>
                                <li><a href='https://app.poolparty.cc'>Join</a></li>
                                <li><a href='#'>Host</a></li>
                                <li><a href='https://t.me/poolpartycc'>Contact Us</a></li>
                            </ul>
                            <a href='https://app.poolparty.cc' class='mobile-nav-cta'>Launch App</a>
                        </div>
                    </div>

                    <div class='hero-content'>
                        <h1 class='logo'>pool</h1>
                        <p class='subheader'>
                            Pool simplifies event funding—secure sponsors, collect contributions in any currency, and
                            automate payouts with full transparency.
                        </p>
                        <a href='https://app.poolparty.cc' class='cta-button'>Launch App</a>
                    </div>

                    <div class='phone-img-container'>
                        <img
                            src='/mobile-hero.png'
                            alt='Pool app on mobile phones'
                            class='phone-image'
                            width='800'
                            height='1200'
                            loading='eager'
                            decoding='async'
                            fetchpriority='high'
                        />

                        <div class='coin-floating coin-1'>
                            <img
                                src='/br-coin.png'
                                alt='USD Coin'
                                width='300'
                                height='300'
                                loading='eager'
                                decoding='async'
                            />
                        </div>
                        <div class='coin-floating coin-2'>
                            <img
                                src='/tr-coin.png'
                                alt='Ethereum'
                                width='130'
                                height='130'
                                loading='eager'
                                decoding='async'
                            />
                        </div>
                        <div class='coin-floating coin-3'>
                            <img
                                src='/tl-coin.png'
                                alt='USD Coin'
                                width='122'
                                height='122'
                                loading='eager'
                                decoding='async'
                            />
                        </div>
                        <div class='coin-floating coin-4'>
                            <img
                                src='/bl-coin.png'
                                alt='USD Coin'
                                width='150'
                                height='150'
                                loading='eager'
                                decoding='async'
                            />
                        </div>
                    </div>
                </section>
            </div>

            <section class='intro'>
                <div class='intro-background'>
                    <div class='intro-header'>
                        <h1 class='intro-title'>
                            <span class='blue-text'>Pool, fund, and split</span>
                            <span class='black-text'>smarter for any event</span>
                        </h1>
                    </div>

                    <button class='intro-button'>Launch App</button>

                    <div class='intro-content'>
                        <div class='logo-grid'>
                            <div class='logo-row'>
                                <img src='/logos/logo1.png' alt='Logo 1' />
                                <img src='/logos/logo2.png' alt='Logo 2' />
                                <img src='/logos/logo3.png' alt='Logo 3' />
                                <img src='/logos/logo4.png' alt='Logo 4' />
                                <img src='/logos/logo5.png' alt='Logo 5' />
                                <img src='/logos/logo6.png' alt='Logo 6' />
                                <img src='/logos/logo7.png' alt='Logo 7' />
                                <img src='/logos/logo8.png' alt='Logo 8' />

                                <img src='/logos/logo9.png' alt='Logo 9' />
                                <img src='/logos/logo10.png' alt='Logo 10' />
                                <img src='/logos/logo11.png' alt='Logo 11' />
                                <img src='/logos/logo12.png' alt='Logo 12' />
                                <img src='/logos/logo13.png' alt='Logo 13' />
                                <img src='/logos/logo14.png' alt='Logo 14' />
                                <img src='/logos/logo15.png' alt='Logo 15' />
                                <img src='/logos/logo16.png' alt='Logo 16' />
                                <img src='/logos/logo17.png' alt='Logo 17' />
                                <img src='/logos/logo18.png' alt='Logo 18' />

                                <img src='/logos/logo19.png' alt='Logo 19' />
                                <img src='/logos/logo20.png' alt='Logo 20' />
                                <img src='/logos/logo21.png' alt='Logo 21' />
                                <img src='/logos/logo22.png' alt='Logo 22' />
                                <img src='/logos/logo23.png' alt='Logo 23' />
                                <img src='/logos/logo24.png' alt='Logo 24' />
                                <img src='/logos/logo25.png' class='logo-25' alt='Logo 25' />
                                <img src='/logos/logo26.png' alt='Logo 26' />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <section class='ws'></section>

        <section class='all-in-section'>
            <div class='all-in-wrapper'>
                <div class='all-in-background'>
                    <img src='/all-in-background-four.png' alt='Pool app background' />
                </div>
                <div class='all-in-content'>
                    <h1>All in</h1>
                    <h1>the new</h1>
                    <h1>pool app</h1>
                </div>
                <div class='video-container'>
                    <video class='animation-video' autoplay loop muted playsinline preload='auto' '>
                        <source src='/pool-animation6.mp4' type='video/mp4' />
                    </video>
                </div>
            </div>
        </section>

        <section class='footer'>
            <div class='footer-content'>
                <div class='footer-logo-container'>
                    <div class='footer-logo'>pool</div>
                    <div class='footer-social'>
                        <a href='https://x.com/PartyWithPool'><img src='/x-icon.svg' alt='X Icon' /></a>
                        <a href='https://t.me/poolpartycc'><img src='/telegram-icon.svg' alt='Telegram Icon' /></a>
                    </div>

                    <div class='email-section'>
                        <div class='email-ask'>Want to use pool at your next event?</div>
                        <div class='email-input-container'>
                            <input type='email' class='email-input' placeholder='Enter your email' />
                            <button class='join-waitlist-btn'>Join our waitlist</button>
                        </div>
                    </div>
                </div>

                <div class='footer-links'>
                    <div class='footer-column'>
                        <h3>Play</h3>
                        <ul>
                            <li><a href='https://x.com/PartyWithPool'>Party with Pool</a></li>
                            <li><a href='#'>Documentation</a></li>
                            <li><a href='https://app.poolparty.cc'>Application</a></li>
                        </ul>
                    </div>

                    <div class='footer-column'>
                        <h3>Community</h3>
                        <ul>
                            <li><a href='https://lu.ma/user/partywithpool'>Lu.ma</a></li>
                            <li><a href='https://t.me/poolpartycc'>Support</a></li>
                            <li><a href='#'>FAQs</a></li>
                        </ul>
                    </div>

                    <div class='footer-column'>
                        <h3>Legal</h3>
                        <ul>
                            <li><a href='#'>Pool Hub</a></li>
                            <li><a href='#'>Terms</a></li>
                            <li><a href='#'>Privacy</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class='border'></div>

            <div class='footer-disclaimer'>
                <p class='footer-disclaimer'>
                    Pool is a platform that allows users to create and manage pooled funds for events, payouts, and
                    community initiatives. By using Pool, you acknowledge that you are solely responsible for complying
                    with applicable laws, regulations, and tax obligations. Pool does not provide financial or legal
                    advice, and is not liable for the creation, management, or distribution of funds on the platform.
                    Users must conduct proper due diligence when handling payments, KYC/KYB, or participant rewards. Use
                    of the platform is at your own risk and may be subject to local restrictions.
                </p>
                <p class='copyright'>© 2025 Pool. All rights reserved.</p>
            </div>
        </section>
    </body>

    <!-- Add a very subtle visual hint to help users know to scroll -->
    <!-- <div class='scroll-hint'>
        <span>Scroll to explore</span>
        <svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'>
            <path
                d='M12 5V19M12 19L6 13M12 19L18 13'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'></path>
        </svg>
    </div> -->

    <!-- Load libraries from CDN -->
    <script is:inline src='https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js'></script>
    <script is:inline src='https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js'></script>
    <script is:inline src='https://unpkg.com/lenis@1.1.18/dist/lenis.min.js'></script>

    <script>
        // Add type declarations for external libraries
        declare const gsap: any
        declare const ScrollTrigger: any
        declare const Lenis: any

        // Register ScrollTrigger plugin
        gsap.registerPlugin(ScrollTrigger)

        // Initial entrance animation - slide in from bottom
        const phoneContainer = document.querySelector('.phone-img-container') as HTMLElement | null
        const coins = document.querySelectorAll('.coin-floating') as NodeListOf<HTMLElement>
        const logo = document.querySelector('.logo') as HTMLElement | null
        const subheader = document.querySelector('.subheader') as HTMLElement | null
        const ctaButton = document.querySelector('.cta-button') as HTMLElement | null
        const navbar = document.querySelector('.desktop-navbar') as HTMLElement | null

        // Set initial position (off-screen or invisible)
        gsap.set([phoneContainer, ...coins], {
            y: '100vh',
            opacity: 0,
        })

        gsap.set([logo, subheader, ctaButton], {
            y: 50,
            opacity: 0,
        })

        gsap.set(navbar, {
            y: -50,
            opacity: 0,
        })

        // Create a timeline for the entrance animation
        const entranceTl = gsap.timeline({
            onComplete: () => {
                // Start floating animations after entrance completes
                startFloatingAnimations()
            },
        })

        // Add text, coins and phone to timeline with staggered entrances
        entranceTl
            // Logo animation
            .to(
                logo,
                {
                    y: 0,
                    opacity: 1,
                    duration: 1.2,
                    ease: 'power2.out',
                },
                0,
            )
            // Subheader and button animation together
            .to(
                [subheader, ctaButton],
                {
                    y: 0,
                    opacity: 1,
                    duration: 1,
                    ease: 'power2.out',
                    stagger: 0.1,
                },
                0.3,
            )
            // Coins animation
            .to(
                coins,
                {
                    y: 0,
                    opacity: 1,
                    duration: 1.2,
                    stagger: 0.08,
                    ease: 'back.out(1.7)',
                },
                0.2,
            )
            // Phone animation
            .to(
                phoneContainer,
                {
                    y: 0,
                    opacity: 1,
                    duration: 1.4,
                    ease: 'expo.out',
                },
                0.5,
            )
            // Navbar animation (last element to come in)
            .to(
                navbar,
                {
                    y: 0,
                    opacity: 1,
                    duration: 1.3,
                    ease: 'back.out(1.5)',
                },
                1.2, // Start after other animations are mostly complete
            )

        // Floating animations function (separated to delay until after entrance)
        function startFloatingAnimations() {
            gsap.utils.toArray('.coin-floating').forEach((coin: any, i: number) => {
                // Vertical movement
                gsap.to(coin, {
                    y: -15 - i * 5,
                    duration: 3 + i * 0.3,
                    repeat: -1,
                    yoyo: true,
                    ease: 'sine.inOut',
                    delay: i * 0.2,
                })

                // Rotation
                gsap.to(coin, {
                    rotation: i % 2 === 0 ? 10 : -10,
                    duration: 4 + i * 0.5,
                    repeat: -1,
                    yoyo: true,
                    ease: 'sine.inOut',
                    delay: i * 0.3,
                })

                // Slight horizontal movement
                gsap.to(coin, {
                    x: i % 2 === 0 ? 8 : -8,
                    duration: 5 + i * 0.2,
                    repeat: -1,
                    yoyo: true,
                    ease: 'sine.inOut',
                    delay: i * 0.1,
                })
            })
        }

        ScrollTrigger.create({
            trigger: '.intro',
            start: 'center+=200 center',
            end: '+=150% top',
            scrub: 1,
            onUpdate: (self: any) => {
                const galleryWrapper = document.querySelector('.gallery-wrapper') as HTMLElement | null
                const sideCols = document.querySelectorAll('.col:not(.main)')
                const mainImg = document.querySelector('.img.main img') as HTMLElement | null

                if (!galleryWrapper || !mainImg) return

                const screenWidth = window.innerWidth
                const maxScale = screenWidth < 900 ? 4 : 2.65

                const scale = 1 + self.progress * maxScale
                const yTranslate = self.progress * 300
                const mainImgScale = 2 - self.progress * 0.85

                galleryWrapper.style.transform = `translate(-50%, -50%) scale(${scale})`

                sideCols.forEach((col: Element) => {
                    ;(col as HTMLElement).style.transform = `translateY(${yTranslate}px)`
                })

                mainImg.style.transform = `scale(${mainImgScale})`
            },
        })

        const lenis = new Lenis()
        lenis.on('scroll', ScrollTrigger.update)

        gsap.ticker.add((time: number) => {
            lenis.raf(time * 1000)
        })

        gsap.ticker.lagSmoothing(0)

        // Add video debugging
        document.addEventListener('DOMContentLoaded', () => {
            const video = document.querySelector('.animation-video') as HTMLVideoElement
            if (video) {
                console.log('Video element found')
                video.addEventListener('loadeddata', () => {
                    console.log('Video data loaded')
                    // Force play when data is loaded
                    video.play().catch(e => console.error('Play error:', e))
                })
                video.addEventListener('error', e => {
                    console.error('Video error:', e)
                })
                video.addEventListener('canplay', () => {
                    console.log('Video can play')
                    video.play().catch(e => console.error('Play error:', e))
                })
            } else {
                console.log('Video element not found')
            }
        })

        // Update ScrollTrigger
        ScrollTrigger.create({
            trigger: '.all-in-section',
            start: 'top center',
            onEnter: () => {
                const video = document.querySelector('.animation-video') as HTMLVideoElement
                if (video) {
                    console.log('Playing video')
                    video.play().catch(e => console.error('Play error:', e))
                }
            },
            onLeave: () => {
                const video = document.querySelector('.animation-video') as HTMLVideoElement
                if (video) {
                    console.log('Pausing video')
                    video.pause()
                }
            },
        })

        // Create ScrollTrigger for text animation
        const allInTexts = document.querySelectorAll('.all-in-content h1')
        allInTexts.forEach((text, index) => {
            gsap.to(text, {
                opacity: 1,
                duration: 0.8,
                scrollTrigger: {
                    trigger: '.all-in-section',
                    start: 'top 90%', // Triggers when section is 10% visible
                    toggleActions: 'play none none reverse',
                },
                delay: index * 0.3, // Stagger the animations
            })
        })

        // Add video scaling animation
        const videoContainer = document.querySelector('.video-container')
        if (videoContainer) {
            gsap.fromTo(
                videoContainer,
                {
                    scale: 1.5,
                    opacity: 0,
                },
                {
                    scale: 1,
                    opacity: 1,
                    duration: 1.2,
                    ease: 'power2.out',
                    scrollTrigger: {
                        trigger: '.all-in-section',
                        start: 'top 50%',
                        toggleActions: 'play none none reverse',
                    },
                },
            )
        }

        // Update the intro animation
        const introTimeline = gsap.timeline({
            scrollTrigger: {
                trigger: '.intro',
                start: 'top 70%',
                toggleActions: 'play none none reverse',
            },
        })

        introTimeline
            .from('.intro-title .blue-text', {
                x: -200,
                opacity: 0,
                duration: 1.2,
                ease: 'power3.out',
            })
            .from(
                '.intro-title .black-text',
                {
                    x: 200,
                    opacity: 0,
                    duration: 1,
                    ease: 'power3.out',
                },
                '-=0.8',
            )
            .from(
                '.intro-button',
                {
                    y: 50,
                    opacity: 0,
                    duration: 0.4,
                    ease: 'power2.out',
                },
                '-=0.4',
            )
            .from(
                '.intro-content',
                {
                    y: 100,
                    opacity: 0,
                    duration: 1,
                    ease: 'power2.out',
                },
                '-=0.2',
            )

        // Add ScrollTrigger to hide scroll hint
        // ScrollTrigger.create({
        //     trigger: '.all-in-section',
        //     start: 'top 95%', // When section is 5% visible
        //     onEnter: () => {
        //         const scrollHint = document.querySelector('.scroll-hint') as HTMLElement | null
        //         if (scrollHint) {
        //             scrollHint.style.opacity = '0'
        //             setTimeout(() => {
        //                 scrollHint.style.display = 'none'
        //             }, 300) // Hide after fade out
        //         }
        //     },
        // })

        // Add this to your existing script
        document.addEventListener('DOMContentLoaded', () => {
            const hamburger = document.querySelector('.hamburger-menu')
            const closeButton = document.querySelector('.close-menu')
            const mobileNav = document.querySelector('.mobile-nav')
            const body = document.body

            function closeMenu() {
                hamburger?.classList.remove('active')
                mobileNav?.classList.remove('active')
                body.style.overflow = ''
            }

            function openMenu() {
                hamburger?.classList.add('active')
                mobileNav?.classList.add('active')
                body.style.overflow = 'hidden'
            }

            hamburger?.addEventListener('click', openMenu)
            closeButton?.addEventListener('click', closeMenu)

            // Close mobile menu when clicking outside
            document.addEventListener('click', e => {
                const target = e.target as HTMLElement
                if (
                    !target.closest('.mobile-nav') &&
                    !target.closest('.hamburger-menu') &&
                    mobileNav?.classList.contains('active')
                ) {
                    closeMenu()
                }
            })

            // Close mobile menu when clicking a link
            const mobileLinks = document.querySelectorAll('.mobile-nav a')
            mobileLinks.forEach(link => {
                link.addEventListener('click', closeMenu)
            })
        })
    </script>

    <style>
        /* Font definitions */
        .raleway-black {
            font-family: 'Raleway', sans-serif;
            font-optical-sizing: auto;
            font-weight: 900;
            font-style: normal;
        }

        .raleway-bold {
            font-family: 'Raleway', sans-serif;
            font-optical-sizing: auto;
            font-weight: 700;
            font-style: normal;
        }

        .raleway-regular {
            font-family: 'Raleway', sans-serif;
            font-optical-sizing: auto;
            font-weight: 400;
            font-style: normal;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 400vh;
            font-family: 'Inter', system-ui, sans-serif;
            background-color: #fff5e9;
        }

        /* Update all Raleway font instances to use the new classes */
        h1,
        .logo,
        .footer-logo {
            font-family: 'Raleway', sans-serif;
            font-optical-sizing: auto;
            font-weight: 800;
            font-style: normal;
        }

        .logo {
            color: white;
            font-weight: 800;
        }

        .intro-title {
            font-family: 'Raleway', sans-serif;
            font-optical-sizing: auto;
            font-weight: 900;
            font-style: normal;
        }

        .all-in-content h1 {
            font-family: 'Raleway', sans-serif;
            font-optical-sizing: auto;
            font-weight: 900;
            font-style: normal;
        }

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .gallery-wrapper img {
            border-radius: 32px;
        }

        .sticky {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            min-width: 100%;
            height: 100vh;
            padding: 0;
            margin: 0;
            background-color: #fff5e9;
            overflow: hidden;
            z-index: 0;
        }

        h1 {
            font-size: 12vw;
            line-height: 1;
            letter-spacing: -0.025em;
        }

        p {
            font-size: 17px;
            font-weight: 500;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .gallery-wrapper {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(1);
            width: 160%;
            min-width: 160%;
            height: 100vh;
            display: flex;
            gap: 4em;
            z-index: 0;
        }

        .col {
            position: relative;
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 4em;
            will-change: transform;
            border-radius: 32px;
        }

        .img {
            flex: 1;
            overflow: hidden;
            background-color: #fff;
            border-radius: 32px;
        }

        .img.main img {
            position: relative;
            transform: scale(2);
            will-change: transform;
        }

        .main-content {
            position: relative;
            z-index: 1;
            width: 100%;
            min-width: 100%;
            max-width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        section {
            position: relative;
            width: 100%;
            min-width: 100%;
            height: 100vh;
            background-color: transparent;
            padding: 0;
            margin: 0;
            overflow-x: hidden;
        }

        section.intro {
            padding: 42px;
            background-color: #fff5e9;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .hero-wrapper {
            padding: clamp(20px, 4vw, 42px);
            box-sizing: border-box;
            background-color: #fff5e9;
            width: 100%;
            min-width: 100%;
            max-width: 100%;
            height: auto;
            overflow: hidden;
            margin: 0;
            position: relative;
        }

        .hero {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            height: auto;
            min-height: 100vh;
            background-color: transparent;
            overflow: hidden;
            box-sizing: border-box;
            border-radius: clamp(40px, 6vw, 80px);
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
            width: 100%;
            margin: 0;
        }

        .hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
            border-radius: clamp(40px, 6vw, 80px);
        }

        .hero-background img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: clamp(40px, 6vw, 80px);
        }

        .nav-container {
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 32px;
            z-index: 100;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
        }

        /* Desktop Navigation */
        .desktop-navbar {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 12px 24px;
            border-radius: 50px;
            background-color: #000;
        }

        .nav-links {
            display: flex;
            gap: 32px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            font-weight: 500;
            transition: opacity 0.2s ease;
        }

        .nav-links a:hover {
            opacity: 0.8;
        }

        /* Mobile Hamburger Button */
        .hamburger-menu {
            display: none;
            background-color: #000;
            border: none;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            position: absolute;
            top: 32px;
            right: 32px;
            z-index: 101;
            align-items: center;
            justify-content: center;
        }

        .hamburger-menu span {
            display: block;
            width: 20px;
            height: 2px;
            background-color: white;
            position: absolute;
            border-radius: 2px;
            transition: transform 0.3s ease;
        }

        .hamburger-menu span:nth-child(1) {
            transform: translateY(-6px);
        }

        .hamburger-menu span:nth-child(3) {
            transform: translateY(6px);
        }

        /* Active hamburger icon */
        .hamburger-menu.active span:nth-child(1) {
            transform: rotate(45deg);
        }

        .hamburger-menu.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger-menu.active span:nth-child(3) {
            transform: rotate(-45deg);
        }

        /* Mobile Navigation */
        .mobile-nav {
            position: fixed;
            top: 0;
            left: 100%;
            width: 100%;
            height: 100vh;
            background-color: white;
            z-index: 100;
            transition: 0.3s ease;
        }

        .mobile-nav.active {
            left: 0;
        }

        .mobile-nav-content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            padding: 80px 40px 40px;
            position: relative;
        }

        .close-menu {
            position: absolute;
            top: 32px;
            right: 32px;
            background: none;
            border: none;
            cursor: pointer;
            z-index: 102;
            color: #000;
        }

        .mobile-nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .mobile-nav li {
            margin: 24px 0;
        }

        .mobile-nav a {
            color: #000;
            text-decoration: none;
            font-size: 32px;
            font-weight: 600;
            display: block;
            padding: 10px 0;
            transition: opacity 0.2s ease;
        }

        .mobile-nav a:hover {
            opacity: 0.7;
        }

        .mobile-nav-cta {
            background-color: #000;
            color: white;
            border: none;
            padding: 16px 32px;
            border-radius: 50px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease;
            width: 100%;
            max-width: 200px;
            margin: 40px auto 0;
        }

        .mobile-nav-cta:hover {
            transform: translateY(-2px);
        }

        /* Media query for mobile */
        @media (max-width: 770px) {
            .desktop-navbar {
                display: none;
            }

            .hamburger-menu {
                display: flex;
            }
        }

        /* Media query for very small screens */
        @media (max-width: 400px) {
            .hamburger-menu {
                top: 20px;
                right: 20px;
                width: 32px;
                height: 32px;
            }

            .hamburger-menu span {
                width: 14px;
            }

            .close-menu {
                top: 20px;
                right: 20px;
            }
        }

        .hero-content {
